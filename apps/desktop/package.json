{
  "name": "@carto/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Application de bureau Windows et macOS : serveur Cartographe AWS local (127.0.0.1, TLS 1.3) dans une fenêtre Electron.",
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "node ../../scripts/desktop.mjs stage",
    "start": "node ../../scripts/desktop.mjs start",
    "dist": "node ../../scripts/desktop.mjs dist"
  },
  "dependencies": {
    "@carto/security": "workspace:*",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
