{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudMapLectureSeule",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<ACCOUNT_ID_OUTIL>:root" },
      "Action": "sts:AssumeRole",
      "Condition": { "StringEquals": { "sts:ExternalId": "<EXTERNAL_ID>" } }
    }
  ]
}
